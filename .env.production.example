# ─────────────────────────────────────────────────────────────────────────────
# FortuneX — production environment
#
#   cp .env.production.example .env.production
#
# Then fill in every value marked REQUIRED. The API refuses to start on a
# placeholder secret, which is deliberate: a checked-in default is public
# knowledge, and the failure is silent right up until someone signs in as an
# admin they invented.
#
# Never commit the filled-in file. `.gitignore` already covers .env* — check
# that it still does before your first deploy.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=production

# ── domain ───────────────────────────────────────────────────────────────────
# REQUIRED. The proxy obtains a certificate for this, so it must already point
# at this server before the stack starts.
DOMAIN=fortunex.example.com
ACME_EMAIL=ops@example.com

# What the browser calls. Leave blank to let the frontend resolve it from the
# page's own origin, which is what you want behind a single domain.
NEXT_PUBLIC_API_URL=
WEB_URL=https://fortunex.example.com

# ── database ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate: openssl rand -base64 32
POSTGRES_PASSWORD=
POSTGRES_USER=fortunex
POSTGRES_DB=fortunex

# Host names are the compose service names — these containers are not published.
DATABASE_URL=postgresql://fortunex:${POSTGRES_PASSWORD}@postgres:5432/fortunex?schema=public
REDIS_URL=redis://redis:6379

# ── secrets ──────────────────────────────────────────────────────────────────
# REQUIRED, and all three must differ. Generate each separately:
#
#   openssl rand -base64 48
#
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Encrypts TOTP seeds and the hot wallet key at rest.
#
# Treat this as permanent. Rotating it invalidates every enrolled authenticator
# and makes the payout key unreadable — plan the re-encryption first, or every
# member with 2FA is locked out at once.
ENCRYPTION_KEY=

# ── behind the proxy ─────────────────────────────────────────────────────────
# How many reverse proxies sit in front of the API. With the bundled Caddy that
# is exactly 1.
#
# This is not cosmetic. Too low and every request appears to come from the
# proxy: the rate limiter throttles all members as one, the audit log records a
# single address, and the admin IP allowlist degrades to allow-all or deny-all.
# Too high and a client can prepend a forged X-Forwarded-For and choose the
# address the allowlist checks.
TRUST_PROXY_HOPS=1

PORT=4000

# ── session lifetimes ────────────────────────────────────────────────────────
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── email ────────────────────────────────────────────────────────────────────
# REQUIRED in production. With no host set, every password reset and withdrawal
# code is written to the log instead of delivered — the account recovery path
# simply does not work.
#
# Use a transactional provider with a warmed sending domain, SPF, DKIM and
# DMARC. A fintech sending from a fresh domain lands in spam, and a member who
# never receives their withdrawal code has no way in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="FortuneX <no-reply@fortunex.example.com>"
BRAND_NAME=FortuneX

# ── compensation plan ────────────────────────────────────────────────────────
# Boot defaults only. Once running, these live in the admin Settings screen and
# the database wins — editing them here has no effect on a running system.
DAILY_ROI_PERCENT=0.5
CAP_PASSIVE_PERCENT=250
CAP_ACTIVE_PERCENT=300
WITHDRAW_FEE_PERCENT=5
WITHDRAW_MIN=10
WITHDRAW_MAX=5000
TRADING_DAYS=1,2,3,4,5

# ── on-chain settlement ──────────────────────────────────────────────────────
# OFF unless configured. While off, deposits and payouts are confirmed by an
# operator by hand — that works, it is simply manual.
#
# Before switching this on, read backend/.env.example. In particular: the
# deposit xpub and the payout wallet MUST be different accounts, or the hot
# wallet's own transfers look like member deposits.
#
# A hot wallet key in an environment variable is adequate for modest balances
# and inadequate above that. Above a threshold you are comfortable losing, move
# signing to a KMS or a hardware signer and keep only a float here.
CHAIN_ENABLED=false
# CHAIN_RPC_URL=https://bsc-dataseed.binance.org
# CHAIN_DEPOSIT_XPUB=
# CHAIN_PAYOUT_KEY=
CHAIN_CONFIRMATIONS=15

# ── backups ──────────────────────────────────────────────────────────────────
# Used by ops/backup.sh. Point BACKUP_DIR at a volume that is NOT on this host's
# only disk — a backup that dies with the server is not a backup.
BACKUP_DIR=/var/backups/fortunex
RETAIN_DAYS=30
