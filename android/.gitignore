# Build output and machine-specific config. local.properties holds an absolute
# SDK path, so it must never be shared.
.gradle/
build/
app/build/
local.properties
.idea/
*.iml
captures/
.cxx/

# Release signing. The keystore and its passwords must never reach the history:
# anyone holding them can publish an update that Play will accept as genuine.
keystore.properties
*.jks
*.keystore
