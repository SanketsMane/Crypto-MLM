<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Auth state must never ride a cloud backup onto another device. -->
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
