# ─────────────────────────────────────────────────────────────────────────────
# FortuneX API
#
# Copy to .env and fill in. Everything below has a working default for local
# development EXCEPT the secrets, which production refuses to start without.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000
WEB_URL=http://localhost:3010

DATABASE_URL="postgresql://fortunex:fortunex@localhost:5440/fortunex?schema=public"
# Only needed to run `prisma migrate diff --from-migrations` (CI drift check).
SHADOW_DATABASE_URL="postgresql://fortunex:fortunex@localhost:5440/fortunex_shadow?schema=public"
REDIS_URL="redis://localhost:6390"

# ── Secrets ──────────────────────────────────────────────────────────────────
# Production will not boot if any of these is a placeholder, shorter than 32
# characters, or if the two JWT secrets match. Generate each separately:
#
#   openssl rand -base64 48
#
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
# Encrypts TOTP seeds and the hot wallet key at rest. Rotating this invalidates
# every enrolled authenticator and makes the payout key unreadable — treat it
# as permanent unless you plan the re-encryption.
ENCRYPTION_KEY=change-me

JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── Compensation plan ────────────────────────────────────────────────────────
# Boot defaults only. Once the platform is running these live in Settings and
# the database wins — changing them here has no effect on a running system.
DAILY_ROI_PERCENT=0.5
CAP_PASSIVE_PERCENT=250
CAP_ACTIVE_PERCENT=300
WITHDRAW_FEE_PERCENT=5
WITHDRAW_MIN=10
WITHDRAW_MAX=5000
# ISO weekday numbers that accrue ROI. 1=Mon … 7=Sun.
TRADING_DAYS=1,2,3,4,5

# ── Email ────────────────────────────────────────────────────────────────────
# With no SMTP_HOST, mail is written to the log instead of sent — every flow
# still works end to end on a developer machine. Delivery attempts are always
# recorded in email_logs either way.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
MAIL_FROM="FortuneX <no-reply@fortunex.local>"
BRAND_NAME=FortuneX

# ── On-chain settlement (USDT BEP-20 on BNB Smart Chain) ─────────────────────
#
# OFF by default. While off, deposits and payouts are recorded and confirmed by
# an operator by hand, exactly as before — nothing breaks, it is simply manual.
#
# Turning it on needs three things:
#
#   1. CHAIN_RPC_URL      an RPC endpoint for the network
#   2. CHAIN_DEPOSIT_XPUB the extended PUBLIC key that derives per-member
#                         deposit addresses. Public on purpose: the API can
#                         derive addresses but cannot sign, so a compromise of
#                         this process cannot move funds.
#   3. CHAIN_PAYOUT_KEY   the hot wallet private key for outbound payments,
#                         encrypted with ENCRYPTION_KEY. Only the worker uses
#                         it. Keep it funded with BNB for gas as well as USDT.
#
# The deposit xpub and the payout wallet MUST be different accounts. If the hot
# wallet sits inside the watched deposit tree, its own transfers look like
# member deposits. (The watcher refuses to credit them, but do not rely on that
# as your only defence.)
#
CHAIN_ENABLED=false
# CHAIN_RPC_URL=https://bsc-dataseed.binance.org
CHAIN_ID=56
# USDT on BSC mainnet. Change for testnet.
CHAIN_TOKEN_ADDRESS=0x55d398326f99059fF775485246999027B3197955
CHAIN_TOKEN_DECIMALS=18
# CHAIN_DEPOSIT_XPUB=xpub...
# CHAIN_PAYOUT_KEY=v1....
# Blocks to wait before crediting. 15 is the usual figure for BSC.
CHAIN_CONFIRMATIONS=15
# Blocks per scan. Most providers cap eth_getLogs at 1000–5000.
CHAIN_SCAN_BATCH=500
# Ignore dust below this, so the ledger is not filled with rounding.
CHAIN_MIN_DEPOSIT=1

# ── NOWPayments (crypto checkout for member deposits) ────────────────────────
# Two credentials with different jobs. The API key authorises raising invoices.
# The IPN secret ONLY verifies that a callback really came from NOWPayments —
# it authorises nothing and is not a substitute for the API key.
#
# With no IPN secret, a callback cannot be told apart from a forgery, so
# charging is disabled outright rather than degraded into "credit whatever
# posts to the URL".
#
# NOTE: NOWPayments signs the JSON body RE-SERIALISED WITH SORTED KEYS, not the
# raw bytes OxaPay signs. The two verifiers are not interchangeable.
NOWPAYMENTS_ENABLED=false
# NOWPAYMENTS_API_KEY=
# NOWPAYMENTS_IPN_SECRET=
# Where callbacks land. Defaults to WEB_URL when unset.
# NOWPAYMENTS_CALLBACK_BASE=https://fortunex.cx
#
# Which checkout raises invoices: nowpayments | oxapay. Inferred when only one
# is configured; REQUIRED when both are, because a member sent to the wrong
# checkout pays real money into a deposit that can never be credited.
# DEPOSIT_GATEWAY=nowpayments

# ── Storage ─────────────────────────────────────────────────────────────────
# Where uploaded files are written. Both default to ./storage/<kind> under the
# working directory, which in the container is the mounted `storage` volume.
#
# KYC documents are written outside the web root and are only ever readable
# through the authenticated admin stream. Brand artwork is the opposite by
# design — it is served publicly and cached hard — so the two never share a
# directory, and an object-store driver would need different bucket policies
# for each. Do not point them at the same place.
# KYC_STORAGE_DIR=/app/storage/kyc
# BRAND_STORAGE_DIR=/app/storage/brand
