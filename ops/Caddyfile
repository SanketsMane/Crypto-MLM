# Reverse proxy and TLS.
#
# Caddy over nginx here for one reason: it obtains and renews certificates
# automatically. A platform holding money must not be one expired certificate
# away from every member seeing a browser warning, and manual renewal is how
# that happens.

{
	# Fail loudly at startup rather than serving without TLS.
	email {$ACME_EMAIL:admin@example.com}
}

{$DOMAIN} {
	encode zstd gzip

	# ── security headers ────────────────────────────────────────────────────
	header {
		# Two years, so browsers refuse plain HTTP to this domain outright.
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "SAMEORIGIN"
		Referrer-Policy           "strict-origin-when-cross-origin"
		# The platform never needs any of these.
		Permissions-Policy        "camera=(), microphone=(), geolocation=(), payment=()"

		# Both JWTs live in localStorage, so any injected script can read them.
		# `connect-src 'self'` is the control that matters here: it stops a
		# stolen token being POSTed to an attacker's host. script-src keeps
		# 'unsafe-inline'/'unsafe-eval' because Next's hydration bootstrap needs
		# them and this build has no nonce plumbing — so this is a containment
		# measure, not full XSS immunity.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	# ── API ─────────────────────────────────────────────────────────────────
	handle /api/* {
		# Metrics report member counts and platform liability. Internal only —
		# a scraper reaches the container directly on the compose network.
		@metrics path /api/v1/metrics
		respond @metrics 404

		reverse_proxy api:4000 {
			# The rate limiter, the audit log and the IP allowlist all read the
			# client address. Without this every request appears to come from
			# the proxy, and the allowlist silently protects nothing.
			header_up X-Real-IP {remote_host}
		}
	}

	# ── app builds ──────────────────────────────────────────────────────────
	#
	# Served straight off disk rather than from inside the web image, so
	# publishing a new build is a file copy — no rebuild, no redeploy, and the
	# version the dashboard advertises can never drift from the file people
	# actually receive.
	handle /download/* {
		root * /srv/downloads
		uri strip_prefix /download

		# Android does not recognise the default octet-stream reliably, and a
		# browser that renders an APK inline instead of saving it leaves the
		# member with a blank tab and no file.
		@apk path *.apk
		header @apk Content-Type "application/vnd.android.package-archive"
		header @apk Content-Disposition "attachment"

		# Five minutes: long enough to survive a reload mid-download, short
		# enough that a new build is picked up without anyone clearing a cache.
		header Cache-Control "public, max-age=300"
		file_server
	}

	# ── everything else is the web app ──────────────────────────────────────
	handle {
		reverse_proxy web:3010
	}

	log {
		output stdout
		format json
	}
}
