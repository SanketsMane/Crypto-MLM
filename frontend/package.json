    "react-dom": "^19.2.8",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
